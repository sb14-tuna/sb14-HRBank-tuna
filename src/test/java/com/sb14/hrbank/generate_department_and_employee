        DATE '2020-05-01'
    )
ON CONFLICT (department_name) DO NOTHING;


-- 2. 직원 60명 생성
WITH employee_seed AS (
    SELECT
        number,

        -- 같은 이름을 반복해 ID 보조 정렬을 테스트한다.
        (
            ARRAY[
                '김민수',
                '김민수',
                '이서연',
                '박지훈',
                '최유진',
                '정하늘',
                '오지우',
                '한서준',
                '윤지민',
                '강도윤'
            ]
        )[1 + ((number - 1) % 10)] AS employee_name,

        (
            ARRAY[
                '개발팀',
                '인사팀',
                '마케팅팀',
                '디자인팀',
                '재무팀'
            ]
        )[1 + ((number - 1) % 5)] AS department_name,

        (
            ARRAY[
                '개발자',
                '매니저',
                '디자이너',
                '기획자',
                '분석가'
            ]
        )[1 + ((number - 1) % 5)] AS employee_position,

        -- 20개의 날짜가 반복되므로 같은 입사일을 가진 직원이 생긴다.
        DATE '2023-01-01' + ((number - 1) % 20) AS employee_hiredate,

        CASE
            WHEN ((number - 1) % 10) < 7 THEN 'ACTIVE'
            WHEN ((number - 1) % 10) < 9 THEN 'ON_LEAVE'
            ELSE 'RESIGNED'
        END AS employee_status

    FROM generate_series(1, 60) AS number
)
INSERT INTO employees (
    employee_id,
    employee_name,
    employee_email,
    employee_number,
    employee_position,
    employee_hiredate,
    employee_status,
    department_id,
    file_id
)
SELECT
    nextval('employee_seq'),

    employee_seed.employee_name,

    'seed'
        || lpad(employee_seed.number::text, 3, '0')
        || '@hrbank.test',

    -- EMP-2026 + 8자리 숫자 = 엔티티의 최대 길이 16자
    'EMP-2026'
        || lpad(
            (90000000 + employee_seed.number)::text,
            8,
            '0'
        ),

    employee_seed.employee_position,
    employee_seed.employee_hiredate,
    employee_seed.employee_status,
    departments.department_id,

    -- 샘플 직원은 프로필 이미지 없음
    NULL

FROM employee_seed

JOIN departments
    ON departments.department_name =
       employee_seed.department_name

-- 같은 SQL을 다시 실행해도 중복 오류가 나지 않게 처리
ON CONFLICT DO NOTHING;

COMMIT;